<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F1"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="120dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:strokeColor="#F3DDC7"
            app:strokeWidth="1dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#111827"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tune how the map and lists behave."
                    android:textColor="#6B7280"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsApprovedOnly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Show approved stalls only" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsAutoCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Auto-center map on selection" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingsMyStallsFirst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Prefer my stalls first" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsClearFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:text="Clear favorites"
                    android:textAllCaps="false"
                    app:cornerRadius="18dp"
                    app:backgroundTint="#FFF7ED"
                    android:textColor="#C2410C" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsBackHome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Back to home"
                    android:textAllCaps="false"
                    app:cornerRadius="18dp"
                    app:backgroundTint="#0F766E" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsLogout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Log out"
                    android:textAllCaps="false"
                    app:cornerRadius="18dp"
                    app:strokeColor="#FDBA74"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#FFF7ED"
                    android:textColor="#C2410C" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
