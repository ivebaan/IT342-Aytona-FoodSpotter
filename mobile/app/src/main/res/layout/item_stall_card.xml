<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeColor="#E9E2D8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/stallImage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#F3F4F6"
            android:contentDescription="Stall image"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/stallAccent"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_stall_accent"
                android:gravity="center"
                android:text="🍜"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                android:id="@+id/stallName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1F2937"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stallCuisine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#9A3412"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stallDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#4B5563"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/stallMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#6B7280"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/stallStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_status_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#0F766E"
                android:textSize="11sp"
                android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stallOpenButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Open"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="#F97316"
                    app:iconPadding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stallFavoriteButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="18dp"
                    app:strokeColor="#FDBA74"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#FFF7ED"
                    android:textColor="#C2410C" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
