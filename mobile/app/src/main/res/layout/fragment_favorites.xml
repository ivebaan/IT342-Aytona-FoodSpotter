<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F1"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/favoritesCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#EA580C"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/favoritesClearButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Clear all"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:backgroundTint="#FFF7ED"
                    android:textColor="#C2410C" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/favoritesEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="You do not have any favorites yet."
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/favoritesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp" />

        <FrameLayout
            android:id="@+id/favoritesMapContainer"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="18dp">

            <com.google.android.gms.maps.MapView
                android:id="@+id/favoritesMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/favoritesMapExpand"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|bottom"
                android:layout_margin="10dp"
                android:contentDescription="Expand map"
                app:srcCompat="@drawable/ic_expand"
                app:backgroundTint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
